<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BitChat.Bot.ViewModels"
        x:Class="BitChat.Bot.Views.MainWindow"
        Title="BitChat" Width="750" Height="800"
        x:DataType="vm:MainViewModel">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="10">

    <!-- Status -->
    <Border Grid.Row="0" Background="#ECEFF1" Padding="6" CornerRadius="3" Margin="0,0,0,6">
      <TextBlock Text="{Binding RelayStatus}" FontSize="12"/>
    </Border>

    <!-- Client Panel -->
    <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" Padding="8" CornerRadius="4">
      <Grid RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="*,Auto">
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#F5F5F5" Padding="6" CornerRadius="3" Margin="0,0,0,6">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Your Identity" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Client.IdentityInfo}" FontSize="10" FontFamily="Consolas,monospace"
                       VerticalAlignment="Center"/>
            <Button Command="{Binding Client.CopyNpubCommand}" FontSize="10" Padding="6,2">Copy npub</Button>
            <Button Command="{Binding Client.CopyHexCommand}" FontSize="10" Padding="6,2">Copy hex</Button>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
          <TextBlock Text="To:" VerticalAlignment="Center" FontSize="12"/>
          <TextBox Text="{Binding Client.RecipientPubkey}" Width="420" FontSize="11"
                   Watermark="Recipient pubkey hex"/>
          <CheckBox IsChecked="{Binding Bot.AutoReply}" VerticalAlignment="Center" FontSize="11">
            Bot auto-reply
          </CheckBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
          <TextBox Text="{Binding Client.ComposeText}" Width="580" Watermark="Type a message..." FontSize="12"
                   KeyDown="OnComposeKeyDown"/>
          <Button Command="{Binding Client.SendCommand}" Width="70" Background="#2196F3"
                  Foreground="White" FontSize="12">Send</Button>
        </StackPanel>

        <ScrollViewer Grid.Row="3" Grid.ColumnSpan="2">
          <ItemsControl ItemsSource="{Binding Client.Messages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="6,4" CornerRadius="4" Margin="0,2"
                        Background="{Binding BubbleColor}"
                        HorizontalAlignment="{Binding Alignment}">
                  <StackPanel>
                    <TextBlock Text="{Binding Sender}" FontSize="10" Foreground="#666"/>
                    <TextBlock Text="{Binding Content}" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Time}" FontSize="9" Foreground="#999"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- Divider -->
    <GridSplitter Grid.Row="2" Height="4" Background="#E0E0E0" Margin="0,4"/>

    <!-- Bot Panel -->
    <Border Grid.Row="3" BorderBrush="#E0E0E0" BorderThickness="1" Padding="8" CornerRadius="4">
      <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Background="#F5F5F5" Padding="6" CornerRadius="3" Margin="0,0,0,6">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Bot Identity" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Bot.IdentityInfo}" FontSize="10" FontFamily="Consolas,monospace"
                       VerticalAlignment="Center"/>
            <Button Command="{Binding Bot.CopyNpubCommand}" FontSize="10" Padding="6,2">Copy npub</Button>
            <Button Command="{Binding Bot.CopyHexCommand}" FontSize="10" Padding="6,2">Copy hex</Button>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
          <TextBlock Text="Response:" VerticalAlignment="Center" FontSize="12"/>
          <TextBox Text="{Binding Bot.ResponseTemplate}" Width="200" FontSize="12"/>
          <TextBlock Text="Reply to:" VerticalAlignment="Center" FontSize="11" Foreground="#999"/>
          <TextBlock Text="{Binding Bot.RecipientPubkey}" FontSize="10" FontFamily="Consolas,monospace"
                     TextTrimming="CharacterEllipsis" MaxWidth="180"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2">
          <TextBlock Text="{Binding Bot.Logs}" FontFamily="Consolas,monospace" FontSize="11"
                     TextWrapping="Wrap"/>
        </ScrollViewer>
      </Grid>
    </Border>

  </Grid>
</Window>
