<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BitChat.App.Views.MainWindow"
        Title="BitChat" Width="800" Height="650">

  <Grid RowDefinitions="Auto,*,Auto" Margin="12">
    <StackPanel Spacing="6" Grid.Row="0" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="BitChat" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        <Button Command="{Binding ConnectCommand}" Width="100" Height="30"
                Background="#2196F3" Foreground="White" VerticalAlignment="Center">
          <TextBlock Text="{Binding ConnectText}"/>
        </Button>
        <TextBlock Text="{Binding Npub}" FontSize="10" Opacity="0.5" VerticalAlignment="Center"
                   ToolTip.Tip="Click to copy npub" PointerPressed="OnNpubClick"/>
      </StackPanel>
      <TextBox Text="{Binding RecipientPubkey}" Watermark="Recipient nostr pubkey (hex)" Width="400"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" Background="#F9F9F9" Padding="8">
      <ItemsControl ItemsSource="{Binding Messages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Padding="6" Margin="0,2" CornerRadius="6" Background="{Binding BubbleColor}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Sender}" FontWeight="Bold" FontSize="12"/>
                  <TextBlock Text="{Binding Time}" FontSize="10" Opacity="0.5"/>
                </StackPanel>
                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13" Margin="0,2,0,0"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBox Text="{Binding ComposeText}" Watermark="Type a message..." Grid.Column="0"
               KeyDown="OnComposeKeyDown"/>
      <Button Command="{Binding SendCommand}" Content="Send" Grid.Column="1" Width="70"
              Margin="8,0,0,0" Background="#2196F3" Foreground="White"/>
    </Grid>
  </Grid>
</Window>
